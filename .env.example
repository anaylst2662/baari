# Postgres connection (Supabase, Neon, RDS…). Leave unset to use the embedded
# PGlite database in ./.data/pglite — zero setup for local development.
# DATABASE_URL=postgres://user:pass@host:5432/baari

# Public base URL, used in WhatsApp links.
APP_URL=http://localhost:3000

# Secret used to hash OTP codes and session tokens. Required in production.
AUTH_SECRET=change-me

# Comma-separated E.164 phone numbers that become admins on login.
ADMIN_PHONES=+923000000000

# WhatsApp Business Cloud API. Without these, messages are only logged to the
# admin outbox and OTP codes are shown on screen (development only).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Show OTP codes on screen even in production (for demos/pilots only — insecure).
# DEMO_MODE=true

# Bearer token for GET /api/cron/reminders (booking reminders).
# CRON_SECRET=
