# Copy this file to ".env" (or ".env.local") and fill in the values.
# Never commit your real .env file — it is ignored by git.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase → Project → Connect → "Transaction pooler" connection string
# (port 6543). Replace [YOUR-PASSWORD] with your database password.
# Leave this empty on your laptop to use the built-in local test database.
DATABASE_URL=

# ── Required in production ───────────────────────────────────────────────────
# A long random secret used to protect logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Phone numbers (format +923001234567) that get admin access when they log in.
# Separate several numbers with commas.
ADMIN_PHONES=

# Your site's public address, used in WhatsApp links, e.g. https://baari.pk
# On Vercel this falls back to your project's vercel.app address if empty.
APP_URL=

# ── WhatsApp (needed for real login codes and alerts) ────────────────────────
# From Meta's WhatsApp Business Cloud API. Without these, login is blocked in
# production (codes are only shown on screen when testing locally).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Optional ─────────────────────────────────────────────────────────────────
# Secret for the booking-reminder job at /api/cron/reminders.
CRON_SECRET=

# DEMO_MODE=true shows login codes on screen even in production. Only for a
# closed test with trusted people — anyone could log in as any phone number.
# DEMO_MODE=true

# Max database connections per server instance (default 5).
# DATABASE_POOL_MAX=5
